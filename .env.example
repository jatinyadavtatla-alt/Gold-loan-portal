# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── AI Loan Assistant (Google Gemini) ────────────────────────────────────────
# Keys stay on the server; never use NEXT_PUBLIC_.
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ── Optional overrides ──────────────────────────────────────────────────────
# Mock 24-karat gold rate in rupees per gram (default 7000)
GOLD_RATE_24K_PER_GRAM=7000
